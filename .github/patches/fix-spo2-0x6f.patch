+// MARK: - Animated photo backdrop
+
+struct ObsBackdrop: View {
+    @Environment(\.colorScheme) private var scheme
+    @State private var breathing = false
+
+    var body: some View {
+        GeometryReader { geo in
+            backdrop(size: geo.size)
+        }
+        .ignoresSafeArea()
+        .onAppear { breathing = true }
+    }
+
+    /// Force every layer to the exact proposed size. An `aspectRatio(.fill)`
+    /// image otherwise reports an ideal width larger than the screen, which
+    /// makes the enclosing ZStack grow and centre-crop the whole page.
+    private func backdrop(size: CGSize) -> some View {
+        ZStack(alignment: .bottom) {
+            LinearGradient(
+                colors: scheme == .dark
+                    ? [Obs.paper, Obs.dusk.opacity(0.16), Obs.gold.opacity(0.05)]
+                    : [Obs.paper, Obs.dusk.opacity(0.10), Obs.gold.opacity(0.06)],
+                startPoint: .top, endPoint: .bottom)
+                .frame(width: size.width, height: size.height)
+            photoLayer("city_day", show: scheme == .light, strength: 0.34, size: size)
+            photoLayer("city_night", show: scheme == .dark, strength: 0.52, size: size)
+        }
+        .frame(width: size.width, height: size.height)
+        .clipped()
+    }
+
+    private func photoLayer(_ name: String, show: Bool, strength: Double, size: CGSize) -> some View {
+        Group {
+            if let url = Bundle.main.url(forResource: name, withExtension: "jpg"),
+               let ui = UIImage(contentsOfFile: url.path) {
+                Image(uiImage: ui)
+                    .resizable()
+                    .aspectRatio(contentMode: .fill)
+                    .frame(width: size.width, height: size.height)
+                    .clipped()
+                    .scaleEffect(breathing ? 1.05 : 1.0)
+                    .offset(y: breathing ? -9 : 9)
+                    .opacity(show ? strength : 0)
+                    .animation(.easeInOut(duration: 0.9), value: show)
+                    .animation(.easeInOut(duration: 22).repeatForever(autoreverses: true),
+                               value: breathing)
+            }
+        }
+        .frame(width: size.width, height: size.height)
+        .clipped()
+        .allowsHitTesting(false)
+    }
+}
+
+/// Small geometric Bell Tower badge used next to section titles.
+struct ObsBellTower: View {
+    var size: CGFloat = 22
+    var body: some View {
+        VStack(spacing: 0) {
+            Circle().fill(Obs.gold).frame(width: size * 0.10, height: size * 0.10)
+            eave(width: size * 0.70, height: size * 0.13)
+            Rectangle().fill(Obs.vermilion.opacity(0.88))
+                .frame(width: size * 0.38, height: size * 0.11)
+            eave(width: size * 0.86, height: size * 0.14)
+            Rectangle().fill(Obs.vermilion.opacity(0.88))
+                .frame(width: size * 0.52, height: size * 0.12)
+            eave(width: size, height: size * 0.15)
+            Rectangle().fill(Obs.brick).frame(width: size * 0.76, height: size * 0.10)
+        }
+        .frame(width: size, height: size)
+    }
+    private func eave(width: CGFloat, height: CGFloat) -> some View {
+        Path { p in
+            p.move(to: CGPoint(x: 0, y: height))
+            p.addLine(to: CGPoint(x: width * 0.14, y: 0))
+            p.addLine(to: CGPoint(x: width * 0.86, y: 0))
+            p.addLine(to: CGPoint(x: width, y: height))
+            p.closeSubpath()
+        }
+        .fill(Obs.glaze)
+    }
+}
