+import Foundation
+import SwiftUI
+
+// Full-night curves, one tap from the home screen.
+//
+// Why this exists: "Raw data & charts" makes you pick an event type, then pick a
+// field, and only loads the most recent 400 events — so a whole night never fits
+// on screen and there is no way to read a value at a point in time. Here the
+// whole night is loaded up front, metrics are one tap away, pinch/step zoom widens
+// the plot inside a horizontal scroller, and dragging shows a value cursor.
+//
+// Data comes from the same `RawData.load` / `RawData.points` used by the raw-data
+// screen, so no new database or FFI surface is introduced.
+
+enum NightMetric: String, CaseIterable, Identifiable {
+    case spo2, heartRate, hrv, temperature
+
+    var id: String { rawValue }
+
+    var title: String {
+        switch self {
+        case .spo2: return "血氧"
+        case .heartRate: return "心率"
+        case .hrv: return "HRV"
+        case .temperature: return "皮温"
+        }
+    }
+    var event: String {
+        switch self {
+        case .spo2: return "spo2_event"
+        case .heartRate: return "ibi_and_amplitude_event"
+        case .hrv: return "hrv_event"
+        case .temperature: return "temp_event"
+        }
+    }
+    var field: String {
+        switch self {
+        case .spo2: return "spo2_percent"
+        case .heartRate: return "hr_bpm"
+        case .hrv: return "rmssd_ms"
+        case .temperature: return "temps_c"
+        }
+    }
+    var unit: String {
+        switch self {
+        case .spo2: return "%"
+        case .heartRate: return "bpm"
+        case .hrv: return "ms"
+        case .temperature: return "°C"
+        }
+    }
+    /// Events to ask the store for. Large enough for one whole night, small
+    /// enough that JSON decoding stays quick on a phone.
+    var eventLimit: UInt32 {
+        switch self {
+        case .spo2: return 20000
+        case .heartRate: return 9000
+        case .hrv: return 4000
+        case .temperature: return 12000
+        }
+    }
+    var color: Color {
+        switch self {
+        case .spo2: return Obs.vermilion
+        case .heartRate: return Obs.alert
+        case .hrv: return Obs.glaze
+        case .temperature: return Obs.gold
+        }
+    }
+    /// Dashed reference line. Only SpO2 has a clinically meaningful threshold.
+    var guide: Double? { self == .spo2 ? 90 : nil }
+    var fixedFloor: Double? { self == .spo2 ? 85 : nil }
+    var decimals: Int { self == .temperature ? 1 : 0 }
+}
+
+struct NightCurveView: View {
+    @Environment(\.dismiss) private var dismiss
+
+    struct NightSlice: Identifiable {
+        let id: String
+        let label: String
+        let points: [RawData.Point]
+    }
+
+    @State private var metric: NightMetric = .spo2
+    @State private var nights: [NightSlice] = []
+    @State private var nightIndex = 0
+    @State private var zoom: CGFloat = 1
+    @State private var cursor: CGFloat? = nil      // 0...1 along the whole night
+    @State private var loading = true
+
+    private var current: NightSlice? {
+        nightIndex >= 0 && nightIndex < nights.count ? nights[nightIndex] : nil
+    }
+
+    var body: some View {
+        ZStack(alignment: .top) {
+            Obs.canvas
+            GeometryReader { geo in
+                ScrollView(.vertical, showsIndicators: false) {
+                    content(width: max(geo.size.width - 32, 120))
+                }
+            }
+        }
+        .task { load() }
+        .onChange(of: metric) { _, _ in load() }
+    }
+
+    private func content(width: CGFloat) -> some View {
+        VStack(alignment: .leading, spacing: 14) {
+            header
+            metricPicker
+            nightBar
+            if loading {
+                HStack(spacing: 10) {
+                    ProgressView().tint(Obs.vermilion)
+                    Text("读取整夜数据…").font(Obs.mono(12)).foregroundStyle(Obs.ink2)
+                }
+                .frame(height: 250).frame(maxWidth: .infinity, alignment: .leading)
+            } else if let n = current {
+                statsBar(n)
+                chartBlock(n, width: width)
+                zoomBar
+                hint
+            } else {
+                Text("这一夜没有 \(metric.title) 数据").font(Obs.prose(13))
+                    .foregroundStyle(Obs.ink2)
+                    .frame(height: 250).frame(maxWidth: .infinity, alignment: .leading)
+            }
+            Spacer(minLength: 24)
+        }
+        .padding(16)
+    }
+
+    // MARK: - chrome
+
+    private var header: some View {
+        HStack(spacing: 10) {
+            ObsBellTower(size: 26)
+            VStack(alignment: .leading, spacing: 1) {
+                Text("全夜曲线").font(Obs.serif(20, .semibold)).foregroundStyle(Obs.ink)
+                Text("FULL NIGHT SIGNALS").font(Obs.mono(9, .medium))
+                    .tracking(1.4).foregroundStyle(Obs.muted)
+            }
+            Spacer()
+            Button { dismiss() } label: {
+                Image(systemName: "xmark.circle.fill")
+                    .font(.system(size: 24))
+                    .foregroundStyle(Obs.muted)
+            }
+            .buttonStyle(.plain)
+        }
+    }
+
+    private var metricPicker: some View {
+        HStack(spacing: 8) {
+            ForEach(NightMetric.allCases) { m in
+                Button {
+                    metric = m
+                } label: {
+                    Text(m.title)
+                        .font(Obs.mono(12, metric == m ? .bold : .medium))
+                        .foregroundStyle(metric == m ? Color.white : Obs.ink2)
+                        .padding(.horizontal, 14).padding(.vertical, 8)
+                        .background(metric == m ? Obs.vermilion : Obs.paper,
+                                    in: Capsule())
+                        .overlay(Capsule().strokeBorder(
+                            metric == m ? Obs.vermilion.opacity(0.6) : Obs.rule,
+                            lineWidth: 1))
+                }
+                .buttonStyle(.plain)
+            }
+        }
+    }
+
+    private var nightBar: some View {
+        HStack(spacing: 12) {
+            Button {
+                if nightIndex < nights.count - 1 { nightIndex += 1; cursor = nil }
+            } label: {
+                Image(systemName: "chevron.left").font(.system(size: 15, weight: .semibold))
+                    .foregroundStyle(nightIndex < nights.count - 1 ? Obs.glaze : Obs.muted)
+                    .frame(width: 38, height: 34)
+            }
+            .buttonStyle(.plain)
+            Spacer()
+            VStack(spacing: 1) {
+                Text(current?.label ?? "—")
+                    .font(Obs.mono(13, .semibold)).foregroundStyle(Obs.ink)
+                Text("第 \(nights.count - nightIndex) / \(nights.count) 夜 · \(current?.points.count ?? 0) 点")
+                    .font(Obs.mono(9)).foregroundStyle(Obs.muted)
+            }
+            Spacer()
+            Button {
+                if nightIndex > 0 { nightIndex -= 1; cursor = nil }
+            } label: {
+                Image(systemName: "chevron.right").font(.system(size: 15, weight: .semibold))
+                    .foregroundStyle(nightIndex > 0 ? Obs.glaze : Obs.muted)
+                    .frame(width: 38, height: 34)
+            }
+            .buttonStyle(.plain)
+        }
+        .padding(.vertical, 4)
+        .background(Obs.paper, in: RoundedRectangle(cornerRadius: 10, style: .continuous))
+    }
+
+    private func statsBar(_ n: NightSlice) -> some View {
+        let vals = n.points.map(\.v)
+        let mean = vals.isEmpty ? 0 : vals.reduce(0, +) / Double(vals.count)
+        let low = vals.min() ?? 0
+        let high = vals.max() ?? 0
+        let below = metric.guide.map { g in vals.filter { $0 < g }.count } ?? 0
+        return HStack(spacing: 0) {
+            statCell("均值", fmtNum(mean), Obs.vermilion)
+            statCell("最低", fmtNum(low), Obs.alert)
+            statCell("最高", fmtNum(high), Obs.glaze)
+            if let g = metric.guide {
+                let pct = vals.isEmpty ? 0 : 100 * Double(below) / Double(vals.count)
+                statCell(String(format: "<%.0f%%", g), String(format: "%.1f%%", pct), Obs.muted)
+            }
+        }
+        .padding(.vertical, 8)
+        .background(Obs.paper, in: RoundedRectangle(cornerRadius: 12, style: .continuous))
+        .overlay(RoundedRectangle(cornerRadius: 12, style: .continuous)
+            .strokeBorder(Obs.rule, lineWidth: 1))
+    }
+
+    private func statCell(_ label: String, _ value: String, _ tint: Color) -> some View {
+        VStack(spacing: 3) {
+            Text(label).font(Obs.mono(9)).foregroundStyle(Obs.muted)
+            Text(value).font(Obs.mono(14, .bold)).foregroundStyle(tint).monospacedDigit()
+        }
+        .frame(maxWidth: .infinity)
+    }
+
+    private var zoomBar: some View {
+        HStack(spacing: 8) {
+            Text("缩放").font(Obs.mono(10)).foregroundStyle(Obs.muted)
+            ForEach([CGFloat(1), CGFloat(2), CGFloat(4), CGFloat(8)], id: \.self) { z in
+                Button {
+                    zoom = z
+                    cursor = nil
+                } label: {
+                    Text("\(Int(z))×")
+                        .font(Obs.mono(11, zoom == z ? .bold : .medium))
+                        .foregroundStyle(zoom == z ? Color.white : Obs.ink2)
+                        .padding(.horizontal, 11).padding(.vertical, 6)
+                        .background(zoom == z ? Obs.glaze : Obs.paper, in: Capsule())
+                        .overlay(Capsule().strokeBorder(
+                            zoom == z ? Obs.glaze : Obs.rule, lineWidth: 1))
+                }
+                .buttonStyle(.plain)
+            }
+            Spacer()
+            Text("横滑看细节").font(Obs.mono(9)).foregroundStyle(Obs.muted)
+        }
+    }
+
+    private var hint: some View {
+        Text("点按或拖动曲线可读取该时刻数值；血氧虚线为 90% 参考线，>100% 是固件毛刺。")
+            .font(Obs.prose(11)).foregroundStyle(Obs.muted)
+            .fixedSize(horizontal: false, vertical: true)
+    }
+
+    // MARK: - plot
+
+    private func chartBlock(_ n: NightSlice, width: CGFloat) -> some View {
+        let chartW = width * zoom
+        return VStack(alignment: .leading, spacing: 6) {
+            ScrollView(.horizontal, showsIndicators: true) {
+                ZStack(alignment: .topLeading) {
+                    curve(n.points, width: chartW, height: 240)
+                    if let c = cursor {
+                        cursorMark(c, n.points, width: chartW, height: 240)
+                    }
+                }
+                .frame(width: chartW, height: 240)
+                .contentShape(Rectangle())
+                .simultaneousGesture(
+                    DragGesture(minimumDistance: 0)
+                        .onChanged { v in
+                            cursor = min(max(v.location.x / chartW, 0), 1)
+                        }
+                )
+            }
+            .frame(height: 240)
+            timeline(n.points, width: width)
+        }
+    }
+
+    private func curve(_ points: [RawData.Point], width: CGFloat, height: CGFloat) -> some View {
+        Canvas { ctx, size in
+            guard points.count > 1 else { return }
+            let t0 = points.first!.t
+            let t1 = points.last!.t
+            let span = max(t1 - t0, 1)
+            var lo = points.map(\.v).min()!
+            var hi = points.map(\.v).max()!
+            if let f = metric.fixedFloor { lo = min(lo, f) }
+            let pad = max((hi - lo) * 0.12, 0.5)
+            lo -= pad
+            hi += pad
+            let ySpan = max(hi - lo, 0.001)
+            let inset: CGFloat = 10
+            let w = max(size.width - inset * 2, 1)
+            let h = max(size.height - inset * 2, 1)
+
+            func place(_ p: RawData.Point) -> CGPoint {
+                CGPoint(x: inset + w * CGFloat((p.t - t0) / span),
+                        y: inset + h * (1 - CGFloat((p.v - lo) / ySpan)))
+            }
+
+            for i in 0...4 {
+                let y = inset + h * CGFloat(i) / 4
+                var g = Path()
+                g.move(to: CGPoint(x: inset, y: y))
+                g.addLine(to: CGPoint(x: size.width - inset, y: y))
+                ctx.stroke(g, with: .color(Obs.rule),
+                           style: StrokeStyle(lineWidth: 0.6))
+            }
+            if let g = metric.guide, g > lo, g < hi {
+                let y = inset + h * (1 - CGFloat((g - lo) / ySpan))
+                var gPath = Path()
+                gPath.move(to: CGPoint(x: inset, y: y))
+                gPath.addLine(to: CGPoint(x: size.width - inset, y: y))
+                ctx.stroke(gPath, with: .color(Obs.alert.opacity(0.6)),
+                           style: StrokeStyle(lineWidth: 1, dash: [4, 4]))
+            }
+
+            var line = Path()
+            line.move(to: place(points[0]))
+            for p in points.dropFirst() { line.addLine(to: place(p)) }
+            var fill = line
+            let lastX = place(points[points.count - 1]).x
+            let firstX = place(points[0]).x
+            fill.addLine(to: CGPoint(x: lastX, y: size.height - inset))
+            fill.addLine(to: CGPoint(x: firstX, y: size.height - inset))
+            fill.closeSubpath()
+            ctx.fill(fill, with: .color(metric.color.opacity(0.14)))
+            ctx.stroke(line, with: .color(metric.color),
+                       style: StrokeStyle(lineWidth: 1.4, lineJoin: .round))
+
+            ctx.draw(Text(fmtNum(hi)).font(Obs.mono(9)).foregroundColor(Obs.muted),
+                     at: CGPoint(x: inset + 2, y: 8), anchor: .leading)
+            ctx.draw(Text(fmtNum(lo)).font(Obs.mono(9)).foregroundColor(Obs.muted),
+                     at: CGPoint(x: inset + 2, y: size.height - 8), anchor: .leading)
+        }
+        .frame(width: width, height: height)
+        .background(Obs.paper, in: RoundedRectangle(cornerRadius: 12, style: .continuous))
+        .overlay(RoundedRectangle(cornerRadius: 12, style: .continuous)
+            .strokeBorder(Obs.vermilion.opacity(0.35), lineWidth: 1))
+    }
+
+    private func cursorMark(_ frac: CGFloat, _ points: [RawData.Point],
+                            width: CGFloat, height: CGFloat) -> some View {
+        let x = frac * width
+        let idx = min(points.count - 1, max(0, Int(frac * Double(points.count - 1))))
+        let p = points[idx]
+        return ZStack(alignment: .topLeading) {
+            Rectangle().fill(Obs.glaze.opacity(0.7))
+                .frame(width: 1, height: height)
+                .offset(x: x, y: 0)
+            Circle().fill(metric.color).frame(width: 8, height: 8)
+                .offset(x: x - 4, y: height * 0.5 - 4)
+            VStack(alignment: .leading, spacing: 2) {
+                Text(fmtNum(p.v) + " " + metric.unit)
+                    .font(Obs.mono(13, .bold)).foregroundStyle(Obs.ink)
+                Text(clock(p.t)).font(Obs.mono(10)).foregroundStyle(Obs.ink2)
+            }
+            .padding(.horizontal, 9).padding(.vertical, 6)
+            .background(Obs.paper, in: RoundedRectangle(cornerRadius: 8, style: .continuous))
+            .overlay(RoundedRectangle(cornerRadius: 8, style: .continuous)
+                .strokeBorder(Obs.vermilion.opacity(0.6), lineWidth: 1))
+            .offset(x: min(max(x + 8, 4), max(width - 112, 4)), y: 8)
+        }
+        .frame(width: width, height: height, alignment: .topLeading)
+        .allowsHitTesting(false)
+    }
+
+    private func timeline(_ points: [RawData.Point], width: CGFloat) -> some View {
+        HStack {
+            if let a = points.first { Text(clock(a.t)).font(Obs.mono(9)).foregroundStyle(Obs.muted) }
+            Spacer()
+            if let b = points.last { Text(clock(b.t)).font(Obs.mono(9)).foregroundStyle(Obs.muted) }
+        }
+        .frame(width: width)
+    }
+
+    // MARK: - data
+
+    private func load() {
+        loading = true
+        cursor = nil
+        zoom = 1
+        let page = RawData.load(filter: metric.event, limit: metric.eventLimit)
+        let pts = RawData.points(page.events, field: metric.field, maxPoints: 4000)
+        nights = splitNights(pts)
+        nightIndex = 0
+        loading = false
+    }
+
+    /// Group samples by "night": anything before local noon belongs to the
+    /// previous calendar day, so 00:05 and 06:27 land in the same night.
+    private func splitNights(_ pts: [RawData.Point]) -> [NightSlice] {
+        let cal = Calendar.current
+        var groups: [String: [RawData.Point]] = [:]
+        for p in pts where p.t > 0 {
+            let d = Date(timeIntervalSince1970: p.t)
+            let c = cal.dateComponents([.year, .month, .day, .hour], from: d)
+            var day = cal.date(from: DateComponents(year: c.year, month: c.month, day: c.day)) ?? d
+            if (c.hour ?? 12) < 12 {
+                day = cal.date(byAdding: .day, value: -1, to: day) ?? day
+            }
+            let k = dayKey(day)
+            groups[k, default: []].append(p)
+        }
+        return groups.keys.sorted(by: >).map { k in
+            NightSlice(id: k, label: nightLabel(k),
+                       points: (groups[k] ?? []).sorted { $0.t < $1.t })
+        }
+    }
+
+    private func dayKey(_ d: Date) -> String {
+        let f = DateFormatter()
+        f.dateFormat = "yyyy-MM-dd"
+        return f.string(from: d)
+    }
+
+    private func nightLabel(_ key: String) -> String {
+        let f = DateFormatter()
+        f.dateFormat = "yyyy-MM-dd"
+        guard let d = f.date(from: key) else { return key }
+        let out = DateFormatter()
+        out.locale = Locale(identifier: "zh_CN")
+        out.dateFormat = "M月d日 EEEE 夜"
+        return out.string(from: d)
+    }
+
+    private func clock(_ t: Double) -> String {
+        let f = DateFormatter()
+        f.dateFormat = "HH:mm"
+        return f.string(from: Date(timeIntervalSince1970: t))
+    }
+
+    private func fmtNum(_ v: Double) -> String {
+        metric.decimals == 0
+            ? String(Int(v.rounded()))
+            : String(format: "%.1f", v)
+    }
+}
